attach_or_switch() {
    # If already inside a Tmux session, switch-client instead of attach
    # (Attaching while inside tmux throws a nasty error)
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$SESSION"
    else
        tmux attach-session -t "$SESSION"
    fi
}

# -------------------- MAIN -------------------- #

main() {
    check_dependencies
    scaffold_workspace

    # 1. Check if session exists
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        log_info "Session '$SESSION' already exists. Attaching..."
        attach_or_switch
        exit 0
    fi

    log_info "Creating new Tmux session: $SESSION"

    # 2. Create new session (detached)
    tmux new-session -d -s "$SESSION" -c "$WORK_DIR" -n "Practice"

    # 3. Pane 0 (Left): Main Code
    tmux send-keys -t "${SESSION}:0.0" "nvim $MAIN_FILE" C-m

    # 4. Pane 1 (Top Right): Input
    tmux split-window -h -p 30 -c "$WORK_DIR"
    tmux send-keys -t "${SESSION}:0.1" "nvim $INPUT_FILE" C-m

    # 5. Pane 2 (Bottom Right): Output
    tmux split-window -v -c "$WORK_DIR"
    tmux send-keys -t "${SESSION}:0.2" "nvim +Realtime $OUTPUT_FILE" C-m

    # 6. Final Adjustments
    tmux select-pane -t "${SESSION}:0.0"

    log_success "Workspace ready!"
    attach_or_switch
}

